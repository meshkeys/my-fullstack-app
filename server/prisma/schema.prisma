generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(uuid())
  fullName          String
  email             String     @unique
  password          String
  phoneNumber       String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  isAdmin           Boolean    @default(false)
  isAgent           Boolean    @default(false)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  businesses        Business[]
  assignedFilings   Filing[]   @relation("AgentFilings")
}

model Business {
  id               String       @id @default(uuid())
  businessName     String
  rcNumber         String?      @unique
  businessType     BusinessType
  registrationDate DateTime?
  address          String?
  state            String?
  status           String       @default("active")
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  filings          Filing[]
  directors        Director[]
  trustees         Trustee[]
}

model Director {
  id           String   @id @default(uuid())
  fullName     String
  email        String?
  phoneNumber  String?
  address      String?
  nationality  String?  @default("Nigerian")
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Trustee {
  id          String   @id @default(uuid())
  fullName    String
  email       String?
  phoneNumber String?
  address     String?
  nationality String?  @default("Nigerian")
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Filing {
  id            String        @id @default(uuid())
  filingType    FilingType
  status        FilingStatus  @default(PENDING)
  dueDate       DateTime
  submittedAt   DateTime?
  completedAt   DateTime?
  amount        Float?
  formData      Json?
  slaDeadline   DateTime?
  slaStatus     SLAStatus     @default(ON_TRACK)
  agentId       String?
  agent         User?         @relation("AgentFilings", fields: [agentId], references: [id])
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id])
  messages      FilingMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model FilingMessage {
  id              String        @id @default(uuid())
  filingId        String
  filing          Filing        @relation(fields: [filingId], references: [id])
  sender          MessageSender
  message         String
  isRead          Boolean       @default(false)
  requiresAction  Boolean       @default(false)
  actionType      String?
  requestedDocs   Json?
  attachments     Json?
  createdAt       DateTime      @default(now())
}

model FilingPrice {
  id          String     @id @default(uuid())
  filingType  FilingType @unique
  serviceFee  Float
  govtFee     Float      @default(3000)
  isActive    Boolean    @default(true)
  updatedBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SLAConfig {
  id              String     @id @default(uuid())
  filingType      FilingType @unique
  responseTimeHrs Int        @default(1)
  displayText     String     @default("1 hour")
  warningAtHrs    Int        @default(1)
  escalateAtHrs   Int        @default(2)
  isActive        Boolean    @default(true)
  updatedBy       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model AppSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reminder {
  id         String   @id @default(uuid())
  message    String
  sentAt     DateTime?
  dueDate    DateTime
  isSent     Boolean  @default(false)
  businessId String
  createdAt  DateTime @default(now())
}

enum BusinessType {
  BUSINESS_NAME
  PRIVATE_LIMITED_COMPANY
  PUBLIC_LIMITED_COMPANY
  INCORPORATED_TRUSTEE
  LIMITED_LIABILITY_PARTNERSHIP
}

enum FilingType {
  ANNUAL_RETURNS
  CHANGE_OF_DIRECTORS
  CHANGE_OF_ADDRESS
  CHANGE_OF_NAME
  INCREASE_SHARE_CAPITAL
  AUDITED_ACCOUNTS
  TRUSTEE_CHANGE
  PARTNERSHIP_CHANGE
}

enum FilingStatus {
  PENDING
  IN_REVIEW
  AWAITING_INFO
  PROCESSING
  SUBMITTED_TO_CAC
  COMPLETED
  REJECTED
}

enum MessageSender {
  USER
  AGENT
}

enum SLAStatus {
  ON_TRACK
  AT_RISK
  BREACHED
}